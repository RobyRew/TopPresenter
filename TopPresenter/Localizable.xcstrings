    "Ecranul de prezentare a fost deconectat. Ieșirea este ascunsă până alegi. Ce dorești să faci?" : {
      "comment" : "Alert message",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Präsentationsbildschirm wurde getrennt. Die Ausgabe bleibt ausgeblendet, bis Sie wählen. Was möchten Sie tun?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The presentation screen was disconnected. The output stays hidden until you choose. What would you like to do?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla de presentación se ha desconectado. La salida permanece oculta hasta que elijas. ¿Qué quieres hacer?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
