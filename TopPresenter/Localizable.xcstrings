      }
    },
    "Fiindcă atât de mult a iubit Dumnezeu lumea, că a dat pe singurul Lui Fiu, pentru ca oricine crede în El să nu piară, ci să aibă viața veșnică." : {
      "comment" : "Layout editor sample verse",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For God so loved the world, that he gave his only Son, that whoever believes in him should not perish but have eternal life."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Porque tanto amó Dios al mundo que dio a su Hijo único, para que todo el que cree en él no perezca, sino que tenga vida eterna."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiindcă atât de mult a iubit Dumnezeu lumea, că a dat pe singurul Lui Fiu, pentru ca oricine crede în El să nu piară, ci să aibă viața veșnică."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Car Dieu a tant aimé le monde qu’il a donné son Fils unique, afin que quiconque croit en lui ne périsse point, mais qu’il ait la vie éternelle."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denn so sehr hat Gott die Welt geliebt, dass er seinen eingeborenen Sohn gab, damit jeder, der an ihn glaubt, nicht verloren geht, sondern ewiges Leben hat."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ибо так возлюбил Бог мир, что отдал Сына Своего Единородного, дабы всякий верующий в Него не погиб, но имел жизнь вечную."
          }
        }
      }
    },
