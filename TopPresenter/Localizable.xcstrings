    "Are you sure you want to delete \"%@\"? This cannot be undone.": {
      "comment": "",
      "localizations": {
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigur ștergi „%@”? Nu se poate anula."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Seguro que quieres eliminar «%@»? No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer « %@ » ? Action irréversible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wirklich löschen? Kann nicht rückgängig gemacht werden."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить «%@»? Это нельзя отменить."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete \"%@\"? This cannot be undone."
          }
        }
      }
    },
