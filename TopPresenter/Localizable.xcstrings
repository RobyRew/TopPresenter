    "Toate colecțiile, cântecele, versiunile și cărțile de cântări dispar definitiv. Nu se poate anula." : {
      "comment" : "Advanced confirm message",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Every collection, song, version and songbook is gone for good. This cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todas las colecciones, canciones, versiones y cancioneros desaparecen para siempre. No se puede deshacer."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toate colecțiile, cântecele, versiunile și cărțile de cântări dispar definitiv. Nu se poate anula."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les collections, chants, versions et recueils disparaissent définitivement. Cette action est irréversible."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Sammlungen, Lieder, Versionen und Liederbücher sind endgültig weg. Das lässt sich nicht rückgängig machen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Все коллекции, песни, версии и сборники исчезнут навсегда. Это нельзя отменить."
          }
        }
      }
    },
