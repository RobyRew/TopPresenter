    "La Ascunde/Golește se ascunde doar conținutul — fundalul temei rămâne pe ecran. Dezactivează pentru ecran complet gol." : {
      "comment" : "Tooltip",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On Hide/Clear only the content is hidden — the theme's background stays on screen. Turn off for a completely blank screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al ocultar o limpiar solo se oculta el contenido: el fondo del tema se queda en pantalla. Desactívalo para dejarla totalmente vacía."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Ascunde/Golește se ascunde doar conținutul — fundalul temei rămâne pe ecran. Dezactivează pentru ecran complet gol."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au masquage/effacement, seul le contenu est masqué — l’arrière-plan du thème reste à l’écran. Désactivez pour un écran entièrement vide."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Ausblenden/Leeren wird nur der Inhalt versteckt — der Hintergrund des Themas bleibt auf dem Bildschirm. Ausschalten für einen völlig leeren Bildschirm."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При скрытии/очистке прячется только содержимое — фон темы остаётся на экране. Выключите для полностью пустого экрана."
          }
        }
      }
    },
