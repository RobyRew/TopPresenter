    "„Doar ore : minute” reîmprospătează o dată pe minut în loc de o dată pe secundă" : {
      "comment" : "Tooltip",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Hours : minutes only\" refreshes once a minute instead of once a second"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Solo horas : minutos» se actualiza una vez por minuto en vez de una por segundo"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Doar ore : minute” reîmprospătează o dată pe minut în loc de o dată pe secundă"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Heures : minutes seulement » se rafraîchit une fois par minute au lieu d’une fois par seconde"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Nur Stunden : Minuten“ aktualisiert einmal pro Minute statt einmal pro Sekunde"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Только часы : минуты» обновляется раз в минуту, а не раз в секунду"
          }
        }
      }
    },
    "„În direct” urmărește modulul Media; „fișier propriu” rămâne fix" : {
      "comment" : "Tooltip",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Live\" follows the Media module; \"own file\" stays fixed"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«En directo» sigue al módulo Media; «archivo propio» se queda fijo"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„În direct” urmărește modulul Media; „fișier propriu” rămâne fix"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Direct » suit le module Média ; « fichier propre » reste fixe"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Live“ folgt dem Medien-Modul; „eigene Datei“ bleibt fest"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Эфир» следует за модулем «Медиа»; «свой файл» остаётся неизменным"
          }
        }
      }
    },
    "„Sistem” urmează culoarea de accent și mărimea iconițelor din Setările macOS. Evidențierea colorează selecțiile (versete, capitole, rezultate)." : {
      "comment" : "Settings info",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“System” follows the accent colour and icon size from macOS Settings. Highlighting colours selections (verses, chapters, results)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Sistema» sigue el color de acento y el tamaño de iconos de los Ajustes de macOS. El resaltado colorea las selecciones (versículos, capítulos, resultados)."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Sistem” urmează culoarea de accent și mărimea iconițelor din Setările macOS. Evidențierea colorează selecțiile (versete, capitole, rezultate)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Système » suit la couleur d’accentuation et la taille des icônes des Réglages macOS. La mise en évidence colore les sélections (versets, chapitres, résultats)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„System“ folgt der Akzentfarbe und der Symbolgröße aus den macOS-Einstellungen. Die Hervorhebung färbt Auswahlen (Verse, Kapitel, Ergebnisse)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Система» следует за цветом акцента и размером значков из настроек macOS. Подсветка окрашивает выделения (стихи, главы, результаты)."
          }
        }
      }
    },
    "„Sistem” urmează limba din Setările macOS. Traducerile sunt încă parțiale — textul netradus apare în limba în care a fost scris." : {
      "comment" : "Settings info — language",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“System” follows the language from macOS Settings. Translations are still partial — untranslated text appears in the language it was written in."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Sistema» sigue el idioma de los Ajustes de macOS. Las traducciones aún son parciales: el texto sin traducir aparece en el idioma en que se escribió."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Sistem” urmează limba din Setările macOS. Traducerile sunt încă parțiale — textul netradus apare în limba în care a fost scris."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Système » suit la langue des Réglages macOS. Les traductions sont encore partielles — le texte non traduit apparaît dans la langue dans laquelle il a été écrit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„System“ folgt der Sprache aus den macOS-Einstellungen. Die Übersetzungen sind noch unvollständig — nicht übersetzter Text erscheint in der Sprache, in der er geschrieben wurde."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Система» следует за языком из настроек macOS. Переводы пока неполные — непереведённый текст отображается на языке оригинала."
          }
        }
      }
    },
