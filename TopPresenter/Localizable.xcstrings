    "Prefixează fiecare verset cu numărul lui, ex. „(3) Fiindcă atât de mult…”." : {
      "comment" : "Tooltip",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefix each verse with its number, e.g. “(3) For God so loved…”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antepone a cada versículo su número, p. ej. «(3) Porque tanto amó Dios…»."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prefixează fiecare verset cu numărul lui, ex. „(3) Fiindcă atât de mult…”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Préfixer chaque verset de son numéro, p. ex. « (3) Car Dieu a tant aimé… »."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedem Vers seine Nummer voranstellen, z. B. „(3) Denn so sehr hat Gott …“."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ставить перед каждым стихом его номер, например «(3) Ибо так возлюбил…»."
          }
        }
      }
    },
