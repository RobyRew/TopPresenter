    "Ce mare ești Tu, Doamne!\nCât de minunate sunt lucrările Tale,\nÎntreg pământul cântă slava Ta." : {
      "comment" : "Layout editor sample song lyrics",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How great Thou art, O Lord!\nHow wonderful are Thy works,\nThe whole earth sings Thy glory."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Cuán grande es Él, Señor!\nQué maravillosas son tus obras,\nToda la tierra canta tu gloria."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce mare ești Tu, Doamne!\nCât de minunate sunt lucrările Tale,\nÎntreg pământul cântă slava Ta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que Tu es grand, ô Seigneur !\nQue Tes œuvres sont merveilleuses,\nLa terre entière chante Ta gloire."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie groß bist Du, o Herr!\nWie wunderbar sind Deine Werke,\nDie ganze Erde singt Deine Herrlichkeit."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Как Ты велик, о Господь!\nКак чудны дела Твои,\nВся земля поёт славу Твою."
          }
        }
      }
    },
