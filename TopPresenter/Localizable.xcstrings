    "„Sistem” urmează culoarea de accent și mărimea iconițelor din Setările macOS. Evidențierea colorează selecțiile (versete, capitole, rezultate).": {
      "comment": "",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“System” follows the accent colour and icon size from macOS Settings. Highlighting colours selections (verses, chapters, results)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» sigue el color de acento y el tamaño de iconos de los Ajustes de macOS. El resaltado colorea las selecciones (versículos, capítulos, resultados)."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Sistem” urmează culoarea de accent și mărimea iconițelor din Setările macOS. Evidențierea colorează selecțiile (versete, capitole, rezultate)."
          }
        }
      }
    },
    "„Sistem” urmează limba din Setările macOS. Traducerile sunt încă parțiale — textul netradus apare în limba în care a fost scris.": {
      "comment": "",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“System” follows the language from macOS Settings. Translations are still partial — untranslated text appears in the language it was written in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sistema» sigue el idioma de los Ajustes de macOS. Las traducciones aún son parciales: el texto sin traducir aparece en el idioma en que se escribió."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "„Sistem” urmează limba din Setările macOS. Traducerile sunt încă parțiale — textul netradus apare în limba în care a fost scris."
          }
        }
      }
    },
