    "Biblia curentă nu are date interliniare — încarcă un modul cu Strong/interliniar (ex. ENINT, ASTL). Bibliile simple (EDC100) rămân normale.": {
      "comment": "",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current Bible has no interlinear data — load a module with Strong's/interlinear (e.g. ENINT, ASTL). Plain Bibles (EDC100) stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La Biblia actual no tiene datos interlineales; carga un módulo con Strong/interlineal (p. ej. ENINT, ASTL). Las Biblias simples (EDC100) siguen igual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblia curentă nu are date interliniare — încarcă un modul cu Strong/interliniar (ex. ENINT, ASTL). Bibliile simple (EDC100) rămân normale."
          }
        }
      }
    },
