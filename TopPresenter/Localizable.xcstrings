    },
    "Temele dispar din galerie. Layout-urile care le-au folosit rămân neschimbate — o temă este o fotografie salvată, nu o legătură vie." : {
      "comment" : "Advanced confirm message",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The themes disappear from the gallery. Layouts that used them are unchanged — a theme is a saved snapshot, not a live link."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Temele dispar din galerie. Layout-urile care le-au folosit rămân neschimbate — o temă este o fotografie salvată, nu o legătură vie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los temas desaparecen de la galería. Los diseños que los usaron no cambian: un tema es una instantánea guardada, no un vínculo vivo."
