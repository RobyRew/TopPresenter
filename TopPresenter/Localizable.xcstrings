    "S-a conectat un ecran nou. Muți prezentarea pe el?": {
      "comment": "Alert message",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new screen was connected. Move the presentation to it?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha conectado una pantalla nueva. ¿Mover la presentación a ella?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nouvel écran a été connecté. Y déplacer la présentation ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein neuer Bildschirm wurde angeschlossen. Präsentation dorthin verschieben?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключён новый экран. Перенести на него презентацию?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "S-a conectat un ecran nou. Muți prezentarea pe el?"
          }
        }
      }
    },
    "Ecranul de prezentare a fost deconectat. Ieșirea este ascunsă până alegi. Ce dorești să faci?": {
      "comment": "Alert message",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The presentation screen was disconnected. The output stays hidden until you choose. What would you like to do?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pantalla de presentación se ha desconectado. La salida permanece oculta hasta que elijas. ¿Qué quieres hacer?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'écran de présentation a été déconnecté. La sortie reste masquée jusqu'à votre choix. Que souhaitez-vous faire ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Präsentationsbildschirm wurde getrennt. Die Ausgabe bleibt ausgeblendet, bis Sie wählen. Was möchten Sie tun?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экран презентации отключён. Вывод скрыт до вашего выбора. Что сделать?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecranul de prezentare a fost deconectat. Ieșirea este ascunsă până alegi. Ce dorești să faci?"
          }
        }
      }
    },
