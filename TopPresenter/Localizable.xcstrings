    "Layout" : {
      "comment" : "Editor tab",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layout"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
