    "Pick a translation to browse its books, chapters and verses — then send any passage to the screen. You can switch translations anytime from the toolbar above." : {
      "comment" : "No-selection splash message",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a translation to browse its books, chapters and verses — then send any passage to the screen. You can switch translations anytime from the toolbar above."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige una traducción para explorar sus libros, capítulos y versículos, y envía cualquier pasaje a la pantalla. Puedes cambiar de traducción cuando quieras desde la barra de arriba."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alege o traducere ca să-i răsfoiești cărțile, capitolele și versetele — apoi trimite orice pasaj pe ecran. Poți schimba traducerea oricând din bara de sus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez une traduction pour parcourir ses livres, chapitres et versets — puis envoyez n’importe quel passage à l’écran. Vous pouvez changer de traduction à tout moment depuis la barre d’outils ci-dessus."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie eine Übersetzung, um ihre Bücher, Kapitel und Verse zu durchsuchen — und senden Sie jede Stelle auf den Bildschirm. Sie können die Übersetzung jederzeit über die Werkzeugleiste oben wechseln."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите перевод, чтобы просматривать его книги, главы и стихи — затем отправьте любой отрывок на экран. Перевод можно сменить в любой момент на панели инструментов выше."
          }
        }
      }
    },
