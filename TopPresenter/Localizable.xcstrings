          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El encuadre (Encajar / Rellenar / zoom) está bajo la vista previa en la pestaña Media."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cadrage (Ajuster / Remplir / zoom) se trouve sous l’aperçu dans l’onglet Média."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
