    },
    "Șterge teme salvate fără să treci prin galeria din editor. O temă folosită de un prezentator nu se șterge — îți spune care." : {
      "comment" : "Advanced footer",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete saved themes without going through the editor's gallery. A theme a presenter still uses is kept — it tells you which."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Șterge teme salvate fără să treci prin galeria din editor. O temă folosită de un prezentator nu se șterge — îți spune care."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina temas guardados sin pasar por la galería del editor. Un tema que un presentador todavía usa no se elimina: te dice cuál."
