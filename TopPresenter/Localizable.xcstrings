          "stringUnit" : {
            "state" : "translated",
            "value" : "Layout"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Макет"
          }
        }
      }
    },
    "Layout-ul se adaptează automat la orice rezoluție, raport de aspect sau PPI: casetele sunt definite procentual, iar fonturile se scalează față de o înălțime de referință de 1080p." : {
      "comment" : "Adaptive layout explanation",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The layout adapts automatically to any resolution, aspect ratio or PPI: boxes are defined as percentages and fonts scale against a 1080p reference height."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El diseño se adapta solo a cualquier resolución, proporción o PPP: las cajas se definen en porcentaje y las fuentes se escalan sobre una altura de referencia de 1080p."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Layout-ul se adaptează automat la orice rezoluție, raport de aspect sau PPI: casetele sunt definite procentual, iar fonturile se scalează față de o înălțime de referință de 1080p."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La disposition s’adapte automatiquement à toute résolution, tout format et tout PPI : les zones sont définies en pourcentages et les polices sont mises à l’échelle par rapport à une hauteur de référence de 1080p."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Layout passt sich automatisch an jede Auflösung, jedes Seitenverhältnis und jede PPI an: Felder werden in Prozent definiert und Schriften anhand einer Referenzhöhe von 1080p skaliert."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Макет автоматически подстраивается под любое разрешение, соотношение сторон и PPI: поля задаются в процентах, а шрифты масштабируются относительно эталонной высоты 1080p."
          }
        }
      }
    },
