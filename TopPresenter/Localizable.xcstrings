    "Istoricul prezentărilor ȘI al căutărilor ⌘K dispare definitiv. Nu se poate anula.": {
      "comment": "",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The presentation history AND the ⌘K search history are gone for good. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial de presentaciones Y el de búsquedas ⌘K desaparecen para siempre. No se puede deshacer."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Istoricul prezentărilor ȘI al căutărilor ⌘K dispare definitiv. Nu se poate anula."
          }
        }
      }
    },
    "La Ascunde/Golește se ascunde doar conținutul — fundalul temei rămâne pe ecran. Dezactivează pentru ecran complet gol.": {
      "comment": "",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On Hide/Clear only the content is hidden — the theme's background stays on screen. Turn off for a completely blank screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al ocultar o limpiar solo se oculta el contenido: el fondo del tema se queda en pantalla. Desactívalo para dejarla totalmente vacía."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "La Ascunde/Golește se ascunde doar conținutul — fundalul temei rămâne pe ecran. Dezactivează pentru ecran complet gol."
          }
        }
      }
    },
