    "Biblia curentă nu are date interliniare — încarcă un modul cu Strong/interliniar (ex. ENINT, ASTL). Bibliile simple (EDC100) rămân normale." : {
      "comment" : "Inspector hint",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The current Bible has no interlinear data — load a module with Strong's/interlinear (e.g. ENINT, ASTL). Plain Bibles (EDC100) stay as they are."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Biblia actual no tiene datos interlineales; carga un módulo con Strong/interlineal (p. ej. ENINT, ASTL). Las Biblias simples (EDC100) siguen igual."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biblia curentă nu are date interliniare — încarcă un modul cu Strong/interliniar (ex. ENINT, ASTL). Bibliile simple (EDC100) rămân normale."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Bible actuelle n’a pas de données interlinéaires — chargez un module avec Strong/interlinéaire (p. ex. ENINT, ASTL). Les Bibles simples (EDC100) restent telles quelles."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aktuelle Bibel hat keine Interlinear-Daten — laden Sie ein Modul mit Strong/Interlinear (z. B. ENINT, ASTL). Einfache Bibeln (EDC100) bleiben unverändert."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В текущей Библии нет подстрочных данных — загрузите модуль со Стронгом/подстрочником (например ENINT, ASTL). Обычные Библии (EDC100) остаются как есть."
          }
        }
      }
    },
