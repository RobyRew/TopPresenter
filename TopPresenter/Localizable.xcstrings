    "„%@” și cele %lld cântece ale ei dispar definitiv. Mută-le întâi în altă colecție dacă vrei să le păstrezi." : {
      "comment" : "Delete collection message",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” and its %lld songs are gone for good. Move them to another collection first if you want to keep them."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” și cele %lld cântece ale ei dispar definitiv. Mută-le întâi în altă colecție dacă vrei să le păstrezi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» y sus %lld canciones desaparecen definitivamente. Muévelas antes a otra colección si quieres conservarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » et ses %lld chants disparaissent définitivement. Déplacez-les d’abord vers une autre collection si vous voulez les garder."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ und seine %lld Lieder sind endgültig weg. Verschieben Sie sie zuerst in eine andere Sammlung, wenn Sie sie behalten möchten."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%@» и его %lld песен исчезнут навсегда. Сначала переместите их в другую коллекцию, если хотите сохранить."
          }
        }
      }
    },
