    "Ecran Deconectat": {
      "comment": "Alert title",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screen Disconnected"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pantalla desconectada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écran déconnecté"
          }
        },
