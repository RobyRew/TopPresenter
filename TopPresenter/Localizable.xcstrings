    "PDF documents, presented a page at a time. Export slides from Keynote or PowerPoint as PDF to show them here." : {
      "comment" : "Format description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF documents, presented a page at a time. Export slides from Keynote or PowerPoint as PDF to show them here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documentos PDF, presentados página a página. Exporta diapositivas de Keynote o PowerPoint como PDF para mostrarlas aquí."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documente PDF, prezentate pagină cu pagină. Exportă diapozitivele din Keynote sau PowerPoint ca PDF ca să le arăți aici."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Documents PDF, présentés page par page. Exportez les diapositives depuis Keynote ou PowerPoint en PDF pour les afficher ici."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF-Dokumente, Seite für Seite präsentiert. Exportieren Sie Folien aus Keynote oder PowerPoint als PDF, um sie hier zu zeigen."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Документы PDF, показываемые по страницам. Экспортируйте слайды из Keynote или PowerPoint в PDF, чтобы показать их здесь."
          }
        }
      }
    },
    "Pe ce slide-uri apare — ex. un logo doar pe primul slide" : {
      "comment" : "Tooltip",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Which slides it appears on — e.g. a logo only on the first slide"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En qué diapositivas aparece — p. ej. un logo solo en la primera"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pe ce slide-uri apare — ex. un logo doar pe primul slide"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur quelles diapositives cela apparaît — p. ex. un logo seulement sur la première"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf welchen Folien es erscheint — z. B. ein Logo nur auf der ersten Folie"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На каких слайдах это появляется — например логотип только на первом"
          }
        }
      }
    },
    "Pe ce slide-uri apare caseta — ex. „Amin.” doar pe ultimul slide" : {
