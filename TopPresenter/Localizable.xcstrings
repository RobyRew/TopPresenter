        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El idioma de la aplicación"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La langue de l’application"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Sprache der App"
          }
        },
        "ru" : {
          "stringUnit" : {
