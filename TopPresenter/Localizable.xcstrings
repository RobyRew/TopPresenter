        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@” există deja (%@, %lld versete). Noul fișier are %lld versete."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
