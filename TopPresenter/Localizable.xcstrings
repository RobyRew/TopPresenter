    "Încadrează = totul vizibil • Umple = acoperă caseta" : {
      "comment" : "Tooltip",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fit = everything visible • Fill = covers the box"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustar = todo visible • Llenar = cubre la caja"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încadrează = totul vizibil • Umple = acoperă caseta"
          }
        }
      }
    },
    "Încadrează arată tot fișierul; Umple acoperă caseta și taie surplusul. Zoom-ul de mai jos se aplică peste această alegere." : {
      "comment" : "Tooltip — fit/fill",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Einpassen“ zeigt die ganze Datei; „Ausfüllen“ deckt die Kassette ab und schneidet den Rest weg. Der Zoom darunter wirkt zusätzlich zu dieser Wahl."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fit shows the whole file; Fill covers the casetă and crops the rest. The zoom below applies on top of that choice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encajar muestra el archivo entero; Rellenar cubre la casilla y recorta el resto. El zoom de abajo se aplica sobre esa elección."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuster montre tout le fichier ; Remplir couvre la cassette et rogne le reste. Le zoom ci-dessous s’applique par-dessus ce choix."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încadrează arată tot fișierul; Umple acoperă caseta și taie surplusul. Zoom-ul de mai jos se aplică peste această alegere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Вписать» показывает файл целиком; «Заполнить» закрывает кассету и обрезает лишнее. Масштаб ниже применяется поверх этого выбора."
          }
        }
      }
    },
    "Închide" : {
      "comment" : "Close\nPalette key hint",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Close"
          }
