    "Încadrarea (Încadrează / Umple / zoom) se află sub previzualizarea din fila Media." : {
      "comment" : "Hint pointing at the framing controls",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Bildeinpassung (Einpassen / Ausfüllen / Zoom) liegt unter der Vorschau im Media-Tab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Framing (Fit / Fill / zoom) lives under the preview in the Media tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El encuadre (Encajar / Rellenar / zoom) está bajo la vista previa en la pestaña Media."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le cadrage (Ajuster / Remplir / zoom) se trouve sous l’aperçu dans l’onglet Média."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Încadrarea (Încadrează / Umple / zoom) se află sub previzualizarea din fila Media."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кадрирование («Вписать» / «Заполнить» / масштаб) находится под предпросмотром на вкладке «Медиа»."
          }
        }
      }
    },
    "Încadrarea se aplică live pe ecranul de proiecție." : {
