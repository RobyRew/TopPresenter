    "\"%@\" is already here — matched on %@. Nothing was imported." : {
      "comment" : "Alert message",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" is already here — matched on %2$@. Nothing was imported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» ya está aquí — coincidencia por %2$@. No se ha importado nada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@\" există deja — potrivire după %2$@. Nu s-a importat nimic."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %1$@ » est déjà là — correspondance sur %2$@. Rien n’a été importé."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ ist bereits vorhanden — Übereinstimmung bei %2$@. Es wurde nichts importiert."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
